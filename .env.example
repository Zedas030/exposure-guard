# Exposure Guard secrets - copy to .env and `chmod 600 .env`. Never commit .env.
# FRITZ!Box user: create a dedicated user with ONLY the right "FRITZ!Box settings" and WITHOUT internet access.
FRITZ_USER=
FRITZ_PASSWORD=
# Home Assistant long-lived access token (Profile > Security > Long-lived access tokens)
HA_TOKEN=
# Tailscale OAuth client with read-only scopes policy_file:read and devices:core:read (optional, for the ACL check)
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=
